# Copy to .env (gitignored) and fill in only what you're using right now —
# every one of these is optional until the feature that needs it runs. A
# fresh clone with no .env at all still builds and runs on mock data.

# ── Data source ───────────────────────────────────────────────────────────────
# "mock" (default if unset) reads src/data/mock-listings.json — zero setup.
# "ghl" reads live GHL contacts — needs the GHL_* vars below. See
# docs/ghl-layer-0.md.
DATA_SOURCE=mock

# ── GoHighLevel (Layer 0/2/4 — listing data, claims, plan upgrades) ────────────
# docs/ghl-layer-0.md
GHL_PIT_TOKEN=
GHL_LOCATION_ID=

# ── Stripe (Layer 4 — checkout for Spotlight/All Access upgrades) ─────────────
# docs/stripe-checkout.md. Unset = mock checkout (upgrades apply immediately,
# no real payment) — the whole flow works locally with none of these set.
STRIPE_SECRET_KEY=
STRIPE_PRICE_FEATURED=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# ── Google Places API (sourcing real businesses + Reviews import) ─────────────
# docs/google-apis.md. Needed for `npm run find-businesses` and
# `npm run reviews`; not needed to run the site itself.
GOOGLE_PLACES_API_KEY=

# ── Reviews auto-backfill webhook (src/pages/api/webhooks/reviews.ts) ─────────
# docs/google-apis.md, docs/ghl-layer-0.md. A GHL workflow POSTs here whenever
# a listing's plan_tier/tags change, so a newly-paid listing's Google rating
# gets fetched once automatically instead of waiting for the next manual
# `npm run reviews` run. Also needs GOOGLE_PLACES_API_KEY and GHL_PIT_TOKEN
# above. Treat this secret like the Vercel Deploy Hook URL — anyone with it
# can trigger a Places API call (a real charge) per request.
REVIEWS_WEBHOOK_SECRET=

# ── Anthropic (AEO business-description generation) ───────────────────────────
# docs/ai-descriptions.md. Needed for `npm run import` to write real
# descriptions instead of a generic placeholder; unset = placeholder text,
# import still completes. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=

# ── Owner self-serve editing + admin editor + consumer accounts ───────────────
# (src/pages/manage/*, src/pages/account/*) — AUTH_SECRET and
# BLOB_READ_WRITE_TOKEN are shared by both systems.
# docs/consumer-accounts.md, docs/ghl-layer-0.md
AUTH_SECRET=              # HMAC signing secret for magic-link tokens + session
                           # cookies. Unset = falls back to a dev-only constant;
                           # REQUIRED before DATA_SOURCE=ghl or anyone could forge a session.
BLOB_READ_WRITE_TOKEN=    # Vercel Blob — gallery photo + logo uploads. No mock
                           # fallback exists; upload route errors clearly if unset.
ADMIN_PASSWORD=           # Shared password for the internal admin editor
                           # (/manage/admin) — lets you edit any listing on a
                           # client's behalf. Required to use that route at all.

# Only if GHL's Conversations API doesn't pan out for magic-link email delivery
# (see docs/consumer-accounts.md) — documented fallback, pick one:
RESEND_API_KEY=

# ── TinaCMS (paused — see the plan this was built from) ───────────────────────
# Only needed once TinaCloud work resumes; not required for local Tina dev
# (`tinacms dev`), which works with zero cloud config.
TINA_TOKEN=
TINA_CLIENT_ID=
