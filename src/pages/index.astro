---
// HOME — the front door.
// Hero (photo + search) → category band → featured tiles → full index →
// channels → add-your-business. Deals row (L4) slots in above Featured.

import BaseLayout from "../layouts/BaseLayout.astro";
import ListingCard from "../components/ListingCard.astro";
import SearchBox from "../components/SearchBox.astro";
import { site } from "../config/site";
import { categorySlug } from "../lib/slug";
import { categoryHues } from "../lib/categories";
import { getListings, getFeaturedListings, getListingsByCategory } from "../lib/directory";

const listings = await getListings();
const featured = await getFeaturedListings();
const byCategory = await getListingsByCategory();

const categories = Object.entries(byCategory).sort((a, b) => b[1].length - a[1].length);
const hues = await categoryHues();
const channels = site.channels.filter((c) => c.url);
---

<BaseLayout
  title={`${site.name} — local businesses across ${site.market}`}
  description={site.tagline}
  showHeaderSearch={false}
>
  <section class="relative">
    <picture>
      <source media="(min-width: 48rem)" srcset={site.hero.src} />
      <img
        src={site.hero.srcSmall}
        alt={site.hero.alt}
        width="2000"
        height="848"
        fetchpriority="high"
        decoding="async"
        class="h-[62vh] min-h-[420px] w-full object-cover sm:h-[68vh]"
      />
    </picture>

    <div class="absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-3xl px-5 text-center">
        <h1
          class="on-photo font-display text-3xl font-extrabold tracking-tight text-on-photo sm:whitespace-nowrap sm:text-4xl lg:text-5xl"
        >
          Find {site.market} Businesses
        </h1>
        <p class="on-photo mt-3 text-base text-on-photo sm:text-lg">
          Search by name, category, city or keyword
        </p>

        <div class="mx-auto mt-6 max-w-2xl shadow-2xl">
          <SearchBox id="hero-search" />
        </div>

        <p class="on-photo meta mt-4 text-on-photo">
          {listings.length} businesses &middot; {categories.length} categories &middot; free to be listed
        </p>
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 pt-14 pb-12">
        <div class="rule-capped pt-5">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 class="font-display text-head">Featured this month</h2>
            <span class="meta">Handpicked from {listings.length} listings</span>
          </div>
        </div>

        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {featured.map((listing, i) => <ListingCard listing={listing} index={i} />)}
        </div>
      </section>
    )
  }

  <section id="categories" class="mx-auto max-w-6xl px-5 pb-12">
    <div class="rule-capped pt-5">
      <h2 class="font-display text-head">Browse by category</h2>
    </div>

    <ol class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(([category, items], i) => (
          <li class={`hue-${hues.get(category)}`}>
            <a
              href={`/category/${categorySlug(category)}`}
              data-reveal
              data-reveal-index={i}
              class="lift flex items-center gap-4 border-2 border-rule bg-paper p-4"
            >
              <span class="hue-block font-display flex h-14 w-14 shrink-0 items-center justify-center text-lg font-extrabold">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="font-display flex-1 text-lg font-extrabold tracking-tight">
                {category}
              </span>
              <span class="meta hue-fg font-bold">{items.length}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <a href="/listings" class="meta mt-6 inline-block font-bold text-signal hover:text-signal-sunk">
      See all {listings.length} listings &rarr;
    </a>
  </section>

  {
    channels.length > 0 && (
      <section class="hue-flamingo mx-auto max-w-6xl px-5 pb-12">
        <div class="rule-capped pt-5">
          <h2 class="font-display text-head">Follow the vybe</h2>
        </div>
        <p class="mt-3 max-w-xl text-sm text-ink-soft">
          We spotlight a local business every week — on video, for free, whether or not
          they ever pay us a cent.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          {channels.map((c) => (
            <a href={c.url} target="_blank" rel="noopener" class="chip hue-block">
              {c.name} &middot; {c.handle}
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section id="add" class="mx-auto max-w-6xl px-5 pb-10">
    <div class="hue-lagoon">
      <div class="hue-block px-6 py-10 sm:px-10">
        <h2 class="font-display max-w-xl text-head">
          Run a business in {site.towns[0]}? You may already be on here.
        </h2>
        <p class="mt-3 max-w-xl text-sub opacity-80">
          Every listing is free and stays free — photos, hours, map, links, the lot.
          Claiming yours just means you control what it says.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/listings" class="bg-ink px-5 py-3 text-sm font-bold text-paper">
            Find your listing to claim it &rarr;
          </a>
          <a href="/add-business" class="border-2 border-ink px-5 py-3 text-sm font-bold">
            Not listed yet? Add your business &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
