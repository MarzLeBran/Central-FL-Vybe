---
// ADD YOUR BUSINESS — for a business that isn't listed yet.
//
// Stays static (the default): nothing here is per-request. It posts to
// /api/add-business, the one route that actually writes. Errors from a failed
// POST come back as ?error=... and are shown by a small inline script reading
// location.search — that keeps this page prerendered HTML rather than pulling
// it into the on-demand surface just to display a banner.
//
// The category field is free text with a datalist suggestion list built from
// every category in use plus the full configured taxonomy (site.categoryGroups)
// — so a genuinely new category is not blocked, and the category-hue system in
// src/lib/categories.ts will assign it a colour automatically either way.

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { TCPA_CONSENT_TEXT } from "../lib/consent";
import { getListingsByCategory } from "../lib/directory";

const known = new Set(Object.keys(await getListingsByCategory()));
site.categoryGroups.flatMap((g) => g.categories).forEach((c) => known.add(c));
const categories = [...known].sort();

// Optional, additive only — see docs/google-apis.md. Absent = the address
// field below is a plain, fully-working text input either way; this key
// just adds a search-as-you-type assist on top of it.
const placesApiKey = import.meta.env.PUBLIC_GOOGLE_PLACES_API_KEY;

const requestedPlan = Astro.url.searchParams.get("plan");
const initialPlan = ["free", "featured", "premium"].includes(requestedPlan ?? "") ? requestedPlan : "free";
---

<BaseLayout
  title={`Add your business — ${site.name}`}
  description={`List your business in ${site.market} for free.`}
>
  <section class="mx-auto max-w-xl px-5 py-14">
    <div class="rule-capped pt-5">
      <h1 class="font-display text-head">Add your business</h1>
    </div>
    <p class="mt-4 max-w-md text-sub text-ink-soft">
      Free and it stays free — or pay now and go live immediately on Good Vybin' or Full
      Thrivin'. Either way it's live right away, with a quick human check-in after.
    </p>

    <p
      id="form-error"
      hidden
      class="mt-6 border-2 border-signal bg-signal/10 px-4 py-3 text-sm font-semibold text-signal-sunk"
    ></p>

    <form method="POST" action="/api/add-business" class="mt-8 space-y-5">
      {/* Honeypot — real visitors never see or fill this in. */}
      <input
        type="text"
        name="hp"
        tabindex={-1}
        autocomplete="off"
        aria-hidden="true"
        class="absolute -left-[9999px] h-0 w-0 opacity-0"
      />

      <div>
        <p class="meta mb-1.5">Choose a plan</p>
        <div class="grid gap-3 sm:grid-cols-3" data-plan-picker>
          {site.plans.map((plan) => (
            <label
              class:list={[
                `hue-${plan.hue}`,
                "lift flex cursor-pointer flex-col gap-1 border-2 border-rule p-3.5 has-[:checked]:border-[var(--h)] has-[:checked]:ring-2 has-[:checked]:ring-[var(--h)]",
              ]}
            >
              <input
                type="radio"
                name="plan"
                value={plan.id}
                checked={plan.id === initialPlan}
                class="sr-only"
                data-plan-radio
              />
              <span class="font-display font-extrabold">{plan.name}</span>
              <span class="meta hue-fg font-bold">
                {plan.price}{plan.id !== "free" && <span class="font-normal"> /yr</span>}
              </span>
            </label>
          ))}
        </div>
      </div>

      <div>
        <label for="businessName" class="meta mb-1.5 block">Business name</label>
        <input
          id="businessName"
          name="businessName"
          type="text"
          required
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        />
      </div>

      <div>
        <label for="category" class="meta mb-1.5 block">Category</label>
        <input
          id="category"
          name="category"
          type="text"
          required
          list="category-options"
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        />
        <datalist id="category-options">
          {categories.map((c) => <option value={c} />)}
        </datalist>
      </div>

      <div class="space-y-5 border-2 border-rule bg-paper-sunk p-4">
        <div>
          <p class="meta font-bold">Tell us about the business</p>
          <p class="mt-1 text-xs text-ink-soft">
            Answer as many of these as you can — we'll write your listing's description
            from them automatically, formatted and ready to go. Nothing here is required,
            and you (or we) can always edit the result afterward.
          </p>
        </div>

        <div>
          <label for="intakeServices" class="meta mb-1.5 block">What products or services do you offer?</label>
          <textarea
            id="intakeServices"
            name="intakeServices"
            rows={2}
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label for="intakeDifferentiators" class="meta mb-1.5 block">What makes you different from others in the area?</label>
          <textarea
            id="intakeDifferentiators"
            name="intakeDifferentiators"
            rows={2}
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          ></textarea>
        </div>

        <div>
          <label for="intakeAudience" class="meta mb-1.5 block">Who do you mainly serve?</label>
          <input
            id="intakeAudience"
            name="intakeAudience"
            type="text"
            placeholder="e.g. families, young professionals, dog owners"
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>

        <div>
          <label for="intakeCredentials" class="meta mb-1.5 block">Any certifications, specialties, or years in business worth mentioning?</label>
          <input
            id="intakeCredentials"
            name="intakeCredentials"
            type="text"
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>

        <div>
          <label for="intakeExtra" class="meta mb-1.5 block">Anything else you want customers to know?</label>
          <textarea
            id="intakeExtra"
            name="intakeExtra"
            rows={2}
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          ></textarea>
        </div>
      </div>

      <div>
        <label for="address" class="meta mb-1.5 block">Address</label>
        {
          placesApiKey && (
            <div id="address-autocomplete-slot" class="mb-2" data-places-key={placesApiKey} />
          )
        }
        <input
          id="address"
          name="address"
          type="text"
          required
          placeholder="Street, city, state, ZIP"
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        />
        {
          placesApiKey && (
            <p class="mt-1 text-xs text-ink-mute">
              Search above to autofill, or just type the full address below — either works.
            </p>
          )
        }
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="phone" class="meta mb-1.5 block">Phone</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
        <div>
          <label for="website" class="meta mb-1.5 block">Website (optional)</label>
          <input
            id="website"
            name="website"
            type="url"
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="ownerName" class="meta mb-1.5 block">Your name (optional)</label>
          <input
            id="ownerName"
            name="ownerName"
            type="text"
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="meta mb-1.5 block">Your email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
      </div>

      <div class="border-t-2 border-rule pt-5">
        <p class="meta mb-1.5">Social media (optional)</p>
        <div class="grid gap-3 sm:grid-cols-2">
          {[
            ["facebook", "Facebook"],
            ["instagram", "Instagram"],
            ["x", "X (Twitter)"],
            ["linkedin", "LinkedIn"],
            ["tiktok", "TikTok"],
            ["youtube", "YouTube"],
          ].map(([key, label]) => (
            <input
              name={`social_${key}`}
              type="url"
              placeholder={label}
              aria-label={label}
              class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
            />
          ))}
        </div>
      </div>

      <label class="flex gap-3 border-t-2 border-rule pt-5 text-xs leading-relaxed text-ink-soft">
        <input type="checkbox" name="tcpaConsent" class="mt-0.5 shrink-0" />
        <span>{TCPA_CONSENT_TEXT}</span>
      </label>

      <button
        type="submit"
        data-submit-btn
        class="w-full bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk"
      >
        {initialPlan === "free" ? "Add my free listing" : "Continue to payment"} &rarr;
      </button>
    </form>
  </section>
</BaseLayout>

<script define:vars={{ plans: [
  { id: "free", label: "Add my free listing" },
  { id: "featured", label: "Continue to payment" },
  { id: "premium", label: "Continue to payment" },
] }}>
  const radios = document.querySelectorAll("[data-plan-radio]");
  const submitBtn = document.querySelector("[data-submit-btn]");
  radios.forEach((radio) => {
    radio.addEventListener("change", () => {
      const match = plans.find((p) => p.id === radio.value);
      if (match && submitBtn) submitBtn.textContent = `${match.label} →`;
    });
  });
</script>

<script>
  const ERRORS: Record<string, string> = {
    missing: "Please fill in the required fields.",
    email: "That email address doesn't look right.",
    social: "Social media links must be full https:// URLs.",
    server: "Something went wrong on our end — please try again in a moment.",
  };
  const error = new URLSearchParams(location.search).get("error");
  if (error) {
    const el = document.getElementById("form-error");
    if (el) {
      el.textContent = ERRORS[error] ?? ERRORS.server;
      el.hidden = false;
    }
  }
</script>

<script>
  // Places Autocomplete assist — see docs/google-apis.md. Absent entirely
  // when PUBLIC_GOOGLE_PLACES_API_KEY isn't set (no slot element, script
  // no-ops immediately below). Deliberately additive, never a replacement:
  // the real #address input stays a plain input the whole time, so typing
  // manually — or this script failing/erroring for any reason — always
  // still works. This uses the "Autocomplete (New)" element specifically
  // (not the legacy google.maps.places.Autocomplete widget), since that's
  // the one covered by Google's free monthly Essentials allowance —
  // see docs/google-apis.md before changing this.
  const slot = document.getElementById("address-autocomplete-slot");
  const apiKey = slot?.dataset.placesKey;
  const addressInput = document.getElementById("address") as HTMLInputElement | null;

  if (slot && apiKey && addressInput) {
    const script = document.createElement("script");
    script.src = `https://maps.googleapis.com/maps/api/js?key=${encodeURIComponent(apiKey)}&libraries=places&loading=async&callback=__initAddressAutocomplete`;
    script.async = true;

    (window as any).__initAddressAutocomplete = async () => {
      try {
        // No @types/google.maps in this repo — `any` throughout rather than
        // a type reference that doesn't resolve.
        const { PlaceAutocompleteElement } = await (window as any).google.maps.importLibrary(
          "places"
        );

        const autocompleteEl = new PlaceAutocompleteElement({
          // US-only fits this directory today; revisit if that ever changes.
          includedRegionCodes: ["us"],
        });
        autocompleteEl.setAttribute(
          "placeholder",
          "Search for the business address…"
        );
        slot.appendChild(autocompleteEl);

        autocompleteEl.addEventListener("gmp-select", async (e: any) => {
          try {
            const place = e.placePrediction.toPlace();
            // Basic Data field (formattedAddress) — stays in the free/cheap
            // tier this session pricing model assumes. Do not add
            // Contact/Atmosphere fields here without re-checking cost.
            await place.fetchFields({ fields: ["formattedAddress"] });
            if (place.formattedAddress) addressInput.value = place.formattedAddress;
          } catch {
            // Selection failed for any reason — the plain input the visitor
            // can still type into is right there, nothing else to do.
          }
        });
      } catch {
        // Script/library failed to load — slot just stays empty; the real
        // address input below it was never touched, so the form still works.
      }
    };

    document.head.appendChild(script);
  }
</script>
