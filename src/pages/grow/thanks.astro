---
// Static, same pattern as /add-business/thanks and /claim/thanks.

import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";
---

<BaseLayout
  title={`Got it — ${site.name}`}
  description="We've got your details and will be in touch."
>
  <section class="mx-auto max-w-xl px-5 py-20 text-center">
    <p class="meta font-bold text-signal">Sent</p>
    <h1 class="font-display mt-3 text-head">Thanks — we'll be in touch</h1>
    <p class="mt-4 text-sub text-ink-soft">
      We read every one of these ourselves. Expect to hear from us shortly to talk through
      what would actually help your business — no automated follow-up, no pitch deck blast.
      Questions in the meantime? Reach us at{" "}
      <a href={`mailto:${site.contactEmail}`} class="font-bold text-signal">
        {site.contactEmail}
      </a>.
    </p>
    <a href="/listings" class="mt-8 inline-block bg-ink px-5 py-3 text-sm font-bold text-paper">
      Back to the directory &rarr;
    </a>
  </section>
</BaseLayout>
