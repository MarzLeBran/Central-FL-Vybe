---
// GROW — the agency retainer pitch. Deliberately separate from /pricing:
// the directory plans are self-serve and sold on that page; this is a sales
// conversation, no price shown, no checkout. Mostly linked from post-claim
// moments (claim/thanks.astro, /manage) rather than primary nav — see the
// golden rule in AGENTS.md that this conversation happens after a claim.
//
// Static (the default): nothing here is per-request. Posts to /api/grow,
// the one route that actually writes. Same error-via-?error= pattern as
// /add-business, to keep this page prerendered HTML.

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { TCPA_CONSENT_TEXT } from "../lib/consent";
import { AGENCY_SERVICES } from "../lib/agency";
---

<BaseLayout
  title={`Grow your business — ${site.name}`}
  description="Beyond the listing: custom websites, review management, social media, and AI-powered follow-up, built around your business."
>
  <section class="mx-auto max-w-3xl px-5 pt-14">
    <div class="rule-capped pt-5">
      <p class="meta font-bold text-signal">Beyond the listing</p>
      <h1 class="font-display mt-2 text-mast">We can run your marketing too.</h1>
    </div>
    <p class="mt-5 max-w-xl text-sub text-ink-soft">
      Your listing gets you found. If you want more than that, we build and run the rest —
      website, reviews, social, follow-up — for a small number of local businesses at a time.
      Every business is different, so there's no fixed package here: we start with a call, figure
      out what you actually need, and build a plan around that.
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-5 pt-12">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        AGENCY_SERVICES.map((s) => (
          <div class="border-2 border-rule bg-paper p-5">
            <p class="font-display text-lg font-extrabold tracking-tight">{s.label}</p>
            <p class="mt-1.5 text-sm text-ink-soft">{s.blurb}</p>
          </div>
        ))
      }
    </div>
    <p class="meta mt-5 text-ink-mute">
      Mix and match — most businesses only need two or three of these, not all five.
    </p>
  </section>

  <section class="mx-auto max-w-xl px-5 py-14">
    <div class="rule-capped pt-5">
      <h2 class="font-display text-head">Tell us about your business</h2>
    </div>
    <p class="mt-3 text-sub text-ink-soft">
      No commitment — this starts a conversation, not a checkout. We'll reach out to talk
      through what would actually move the needle for you.
    </p>

    <p
      id="form-error"
      hidden
      class="mt-6 border-2 border-signal bg-signal/10 px-4 py-3 text-sm font-semibold text-signal-sunk"
    ></p>

    <form method="POST" action="/api/grow" class="mt-8 space-y-5">
      {/* Honeypot — real visitors never see or fill this in. */}
      <input
        type="text"
        name="hp"
        tabindex={-1}
        autocomplete="off"
        aria-hidden="true"
        class="absolute -left-[9999px] h-0 w-0 opacity-0"
      />

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="businessName" class="meta mb-1.5 block">Business name</label>
          <input
            id="businessName"
            name="businessName"
            type="text"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
        <div>
          <label for="contactName" class="meta mb-1.5 block">Your name</label>
          <input
            id="contactName"
            name="contactName"
            type="text"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="meta mb-1.5 block">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
        <div>
          <label for="phone" class="meta mb-1.5 block">Phone</label>
          <input
            id="phone"
            name="phone"
            type="tel"
            required
            class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
          />
        </div>
      </div>

      <div>
        <p class="meta mb-1.5">What are you interested in? (optional)</p>
        <div class="grid gap-2 sm:grid-cols-2">
          {
            AGENCY_SERVICES.map((s) => (
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name={`service_${s.key}`} class="shrink-0" />
                {s.label}
              </label>
            ))
          }
        </div>
      </div>

      <div>
        <label for="message" class="meta mb-1.5 block">Anything else? (optional)</label>
        <textarea
          id="message"
          name="message"
          rows={3}
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        ></textarea>
      </div>

      <label class="flex gap-3 border-t-2 border-rule pt-5 text-xs leading-relaxed text-ink-soft">
        <input type="checkbox" name="tcpaConsent" class="mt-0.5 shrink-0" />
        <span>{TCPA_CONSENT_TEXT}</span>
      </label>

      <button
        type="submit"
        class="w-full bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk"
      >
        Start the conversation &rarr;
      </button>
    </form>
  </section>
</BaseLayout>

<script>
  const ERRORS: Record<string, string> = {
    missing: "Please fill in the required fields.",
    email: "That email address doesn't look right.",
    server: "Something went wrong on our end — please try again in a moment.",
  };
  const error = new URLSearchParams(location.search).get("error");
  if (error) {
    const el = document.getElementById("form-error");
    if (el) {
      el.textContent = ERRORS[error] ?? ERRORS.server;
      el.hidden = false;
    }
  }
</script>
