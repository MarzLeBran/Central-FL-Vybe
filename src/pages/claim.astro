---
// CLAIM — the hinge the whole funnel turns on (see docs/directory-business-model
// in project memory: a claim converts a cold contact into a hand-raised lead).
//
// Server-rendered on demand: the page needs a LIVE lookup of the listing's
// current claimStatus (not a static snapshot) so a listing claimed five minutes
// ago can't be claimed twice. Everything else on the site stays static; this
// and /add-business's endpoint are the only on-demand routes.
//
// The `t` token is today just the GHL contact id — see getListingById in
// directory.ts. That is fine for testing, but a real claim link should carry an
// unguessable token minted by the Layer 3 outreach email, not the raw contact
// id. Tighten this before sending real outreach.

export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config/site";
import { getListingById } from "../lib/directory";
import { TCPA_CONSENT_TEXT } from "../lib/consent";

const listingId = Astro.url.searchParams.get("t") ?? "";
const errorCode = Astro.url.searchParams.get("error");
const listing = await getListingById(listingId);

const ERRORS: Record<string, string> = {
  missing: "Please fill in your name, phone, and email.",
  email: "That email address doesn't look right.",
  notfound: "We couldn't find that listing. It may have already been removed.",
  already: "This listing has already been claimed.",
  server: "Something went wrong on our end — please try again in a moment.",
};
const errorMessage = errorCode ? ERRORS[errorCode] ?? ERRORS.server : null;
---

<BaseLayout
  title={`Claim your listing — ${site.name}`}
  description="Claim your free business listing to correct the details, add photos, and get customer messages sent straight to you."
>
  <section class="mx-auto max-w-xl px-5 py-14">
    {
      !listing ? (
        <div class="rule-capped pt-5">
          <h1 class="font-display text-head">We couldn't find that listing</h1>
          <p class="mt-3 text-sub text-ink-soft">
            The link may be out of date. You can find your business from the full list instead.
          </p>
          <a href="/listings" class="mt-6 inline-block bg-ink px-5 py-3 text-sm font-bold text-paper">
            Browse all listings &rarr;
          </a>
        </div>
      ) : listing.claimStatus === "claimed" ? (
        <div class="rule-capped pt-5">
          <h1 class="font-display text-head">{listing.businessName} is already claimed</h1>
          <p class="mt-3 text-sub text-ink-soft">
            If that was you and something looks wrong, email us at{" "}
            <a href={`mailto:${site.contactEmail}`} class="font-bold text-signal">
              {site.contactEmail}
            </a>{" "}
            and we'll sort it out.
          </p>
          <a href={`/business/${listing.slug}`} class="mt-6 inline-block bg-ink px-5 py-3 text-sm font-bold text-paper">
            View the listing &rarr;
          </a>
        </div>
      ) : (
        <>
          <div class="rule-capped pt-5">
            <p class="meta">Claiming</p>
            <h1 class="font-display text-head">{listing.businessName}</h1>
            <p class="mt-2 text-sm text-ink-soft">
              {listing.category} &middot; {listing.address}
            </p>
          </div>

          <p class="mt-5 max-w-md text-sm text-ink-soft">
            This listing is free and stays free. Claiming it means you control the
            details — photos, hours, description — and messages come straight to you.
          </p>

          {errorMessage && (
            <p class="mt-6 border-2 border-signal bg-signal/10 px-4 py-3 text-sm font-semibold text-signal-sunk">
              {errorMessage}
            </p>
          )}

          <form method="POST" action="/api/claim" class="mt-8 space-y-5">
            <input type="hidden" name="listingId" value={listing.id} />

            {/* Honeypot — real visitors never see or fill this in. */}
            <input
              type="text"
              name="hp"
              tabindex={-1}
              autocomplete="off"
              aria-hidden="true"
              class="absolute -left-[9999px] h-0 w-0 opacity-0"
            />

            <div>
              <label for="ownerName" class="meta mb-1.5 block">Your name</label>
              <input
                id="ownerName"
                name="ownerName"
                type="text"
                required
                class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
              />
            </div>

            <div>
              <label for="email" class="meta mb-1.5 block">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
              />
            </div>

            <div>
              <label for="phone" class="meta mb-1.5 block">Phone</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                required
                class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
              />
            </div>

            <label class="flex gap-3 border-t-2 border-rule pt-5 text-xs leading-relaxed text-ink-soft">
              <input type="checkbox" name="tcpaConsent" class="mt-0.5 shrink-0" />
              <span>{TCPA_CONSENT_TEXT}</span>
            </label>

            <button
              type="submit"
              class="w-full bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk"
            >
              Claim this listing &rarr;
            </button>
          </form>
        </>
      )
    }
  </section>
</BaseLayout>
