---
// Consumer sign-in — email-only, passwordless magic link. Separate from
// /manage/login (business owners) — a different identity system entirely,
// see src/lib/consumers.ts.

import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config/site";

const errorCode = Astro.url.searchParams.get("error");
const sent = Astro.url.searchParams.get("sent") === "1";

const ERRORS: Record<string, string> = {
  expired: "That link has expired. Request a new one below.",
};
const errorMessage = errorCode ? ERRORS[errorCode] ?? null : null;
---

<BaseLayout title={`Log in — ${site.name}`} description="Sign in to your account." widget="none">
  <section class="mx-auto max-w-xl px-5 py-14">
    <div class="rule-capped pt-5">
      <h1 class="font-display text-head">Log in</h1>
      <p class="mt-3 text-sub text-ink-soft">
        Enter your email and we'll send you a sign-in link — no password needed.
      </p>
    </div>

    {
      sent ? (
        <p class="mt-8 border-2 border-ink bg-paper-sunk px-4 py-3 text-sm font-semibold text-ink">
          If that email is on file, a sign-in link is on its way. It expires in 15 minutes.
        </p>
      ) : (
        <>
          {errorMessage && (
            <p class="mt-6 border-2 border-signal bg-signal/10 px-4 py-3 text-sm font-semibold text-signal-sunk">
              {errorMessage}
            </p>
          )}

          <form method="POST" action="/api/account/request-link" class="mt-8 space-y-5">
            <input
              type="text"
              name="hp"
              tabindex={-1}
              autocomplete="off"
              aria-hidden="true"
              class="absolute -left-[9999px] h-0 w-0 opacity-0"
            />

            <div>
              <label for="email" class="meta mb-1.5 block">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
              />
            </div>

            <button
              type="submit"
              class="w-full bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk"
            >
              Send sign-in link &rarr;
            </button>
          </form>

          <p class="mt-6 text-sm text-ink-soft">
            No account yet? <a href="/account/register" class="hue-fg font-bold">Register &rarr;</a>
          </p>
        </>
      )
    }
  </section>
</BaseLayout>
