---
// Internal admin login — a single shared password (this is a tool for you/
// your team, not a multi-admin system; no users table, per golden rule 1),
// checked against ADMIN_PASSWORD. Grants edit access to ANY listing,
// regardless of claim/tier status — see src/lib/auth.ts's admin session.
//
// On-demand, not static — same reason as account/login.astro: the wrong-
// password banner reads Astro.url.searchParams, always empty at build time
// on a prerendered page.

export const prerender = false;

import BaseLayout from "../../../layouts/BaseLayout.astro";
import { site } from "../../../config/site";

const errorCode = Astro.url.searchParams.get("error");
const errorMessage = errorCode === "invalid" ? "Incorrect password." : null;
---

<BaseLayout title={`Admin — ${site.name}`} description="Internal listing editor." widget="none">
  <section class="mx-auto max-w-xl px-5 py-14">
    <div class="rule-capped pt-5">
      <h1 class="font-display text-head">Admin</h1>
      <p class="mt-3 text-sub text-ink-soft">Edit any listing on behalf of a client.</p>
    </div>

    {errorMessage && (
      <p class="mt-6 border-2 border-signal bg-signal/10 px-4 py-3 text-sm font-semibold text-signal-sunk">
        {errorMessage}
      </p>
    )}

    <form method="POST" action="/api/manage/admin-login" class="mt-8 space-y-5">
      <div>
        <label for="password" class="meta mb-1.5 block">Password</label>
        <input
          id="password"
          name="password"
          type="password"
          required
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        />
      </div>
      <button type="submit" class="w-full bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk">
        Sign in &rarr;
      </button>
    </form>
  </section>
</BaseLayout>
