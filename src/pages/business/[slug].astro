---
import '../../styles/global.css';
import { getListings, getListingBySlug } from "../../lib/directory";
import DirectoryWidget from "../../components/DirectoryWidget.astro";
import ListingAgentWidget from "../../components/ListingAgentWidget.astro";

// Pre-render every listing page at build time (great for SEO/AEO).
export async function getStaticPaths() {
  const listings = await getListings();
  return listings.map((l) => ({ params: { slug: l.slug } }));
}

const { slug } = Astro.params;
const listing = await getListingBySlug(slug);
if (!listing) return Astro.redirect("/404");

// ── THE ROUTING RULE ─────────────────────────────────────────────────────────
// Featured page  -> per-listing business agent ONLY.
// Everything else -> directory-wide GHL assistant.
// Never both on one page.
const isFeatured = listing.planTier === "featured";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{listing.businessName} — Directory</title>
    <meta name="description" content={listing.description} />
  </head>
  <body class="bg-white text-slate-900">
    <main class="mx-auto max-w-3xl px-6 py-12">
      <a href="/" class="text-sm text-slate-500 hover:text-slate-900">← Back to directory</a>

      <div class="mt-4 flex items-start justify-between gap-4">
        <div>
          <p class="text-sm font-medium uppercase tracking-wide text-slate-500">{listing.category}</p>
          <h1 class="mt-1 text-3xl font-semibold">{listing.businessName}</h1>
        </div>
        {isFeatured && (
          <span class="rounded-full bg-amber-400 px-3 py-1 text-xs font-semibold text-slate-900">
            ★ Featured
          </span>
        )}
      </div>

      {listing.rating && (
        <p class="mt-2 text-sm text-slate-600">
          ★ {listing.rating} · {listing.reviewCount} reviews
        </p>
      )}

      <p class="mt-6 text-slate-700">{listing.description}</p>

      <dl class="mt-8 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
        <div><dt class="text-slate-400">Address</dt><dd>{listing.address}</dd></div>
        <div><dt class="text-slate-400">Phone</dt><dd>{listing.phone}</dd></div>
        {listing.hours && <div><dt class="text-slate-400">Hours</dt><dd>{listing.hours}</dd></div>}
        {listing.website && (
          <div><dt class="text-slate-400">Website</dt><dd><a href={listing.website} class="underline">Visit</a></dd></div>
        )}
      </dl>

      {!isFeatured && listing.claimStatus === "unclaimed" && (
        <a
          href={`/claim?t=${listing.id}`}
          class="mt-8 inline-block rounded-lg bg-slate-900 px-5 py-3 text-sm font-medium text-white"
        >
          Is this your business? Claim it free →
        </a>
      )}
    </main>

    <!-- ONE widget, chosen by tier. This is the whole two-widget model. -->
    {isFeatured ? <ListingAgentWidget listing={listing} /> : <DirectoryWidget />}
  </body>
</html>
