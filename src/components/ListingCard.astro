---
// One business, as a tile. Used by the home page, the full listings grid and
// every category page — change it once, changes all.
//
// The tile carries its category's hue: the image band, the hover lift shadow
// and the category label all read from --h, set by hueClass() on the wrapper.
// `index` only staggers the scroll-in animation.

import type { Listing } from "../types/listing";
import { isPaidTier } from "../types/listing";
import { site } from "../config/site";
import { hueClass } from "../lib/categories";
import { plainTextDescription } from "../lib/markdown";

interface Props {
  listing: Listing;
  index?: number;
}

const { listing, index = 0 } = Astro.props;
const cover = listing.imageUrls?.[0];
// description is markdown source — strip it to plain text here so the card
// preview never shows raw **/##/- syntax (see src/lib/markdown.ts).
const descriptionPreview = plainTextDescription(listing.description);
const hue = await hueClass(listing.category);

// The mark names the actual plan, so the tiers are visible in the wild rather
// than only on /pricing.
const plan = site.plans.find((p) => p.id === listing.planTier);
const isPaid = isPaidTier(listing.planTier);
// "pending" reads as claimed here too — a self-signup (free or paid, via
// /add-business) already has an owner attached the moment it's submitted;
// "pending" just means you haven't personally confirmed it yet. Showing
// "Claim It" on a listing someone already gave you their info for would be
// actively confusing, not just imprecise.
const isClaimed = listing.claimStatus !== "unclaimed";
---

<div
  data-reveal
  data-reveal-index={index}
  data-slug={listing.slug}
  class:list={[hue, "lift group relative flex flex-col border-2 border-rule bg-paper"]}
>
  {/* Covers the whole card so it stays fully clickable — the follow button
      below sits above it (z-20 vs z-10) so it wins the hit-test in its own
      corner without needing stopPropagation. */}
  <a href={`/business/${listing.slug}`} class="absolute inset-0 z-10" aria-label={listing.businessName} />

  <div class="relative aspect-[16/10] w-full overflow-hidden border-b-4 border-[var(--h)] bg-paper-sunk">
    {
      cover ? (
        <img
          src={cover}
          alt=""
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <img
          src={site.fallbackImage}
          alt=""
          loading="lazy"
          decoding="async"
          class="absolute inset-0 m-auto w-[78%] max-w-full object-contain p-3 opacity-90"
        />
      )
    }

    <div class="absolute left-0 top-0 z-20 flex flex-wrap gap-1 p-1.5">
      {
        isPaid && plan && (
          <span class="chip bg-ink font-bold text-paper">&#9733; {plan.name}</span>
        )
      }
      {
        isClaimed ? (
          <span class="chip border border-ink bg-paper/90 font-bold text-ink">Claimed</span>
        ) : (
          <span class="chip bg-signal font-bold text-paper">Claim It</span>
        )
      }
    </div>

    {/* Inert by default (no JS/logged out) — FollowButtons.astro wires this
        up only when a consumer session's hint cookie is present. */}
    <button
      type="button"
      data-follow-btn
      data-slug={listing.slug}
      aria-label="Follow this listing"
      aria-pressed="false"
      class="absolute right-0 top-0 z-20 flex size-9 items-center justify-center border-2 border-r-0 border-t-0 border-ink bg-paper/90 text-ink hover:border-signal hover:text-signal"
    >
      <svg data-icon="heart-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="M12 21s-6.7-4.3-9.3-8.2C1 10 1.6 6.6 4.3 5.1c2.2-1.2 4.9-.6 6.4 1.3l1.3 1.6 1.3-1.6c1.5-1.9 4.2-2.5 6.4-1.3 2.7 1.5 3.3 4.9 1.6 7.7C18.7 16.7 12 21 12 21Z" />
      </svg>
      <svg data-icon="heart-filled" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
        <path d="M12 21s-6.7-4.3-9.3-8.2C1 10 1.6 6.6 4.3 5.1c2.2-1.2 4.9-.6 6.4 1.3l1.3 1.6 1.3-1.6c1.5-1.9 4.2-2.5 6.4-1.3 2.7 1.5 3.3 4.9 1.6 7.7C18.7 16.7 12 21 12 21Z" />
      </svg>
    </button>
  </div>

  <div class="flex flex-1 flex-col p-4">
    <p class="meta flex flex-wrap items-center gap-x-2">
      <span class="hue-fg font-bold">{listing.category}</span>
    </p>

    <h3 class="font-display mt-1.5 text-lg font-extrabold leading-tight tracking-tight">
      {listing.businessName}
    </h3>

    {
      listing.rating && (
        <p class="hue-fg mt-1 flex items-center gap-1 text-sm font-bold">
          &#9733; {listing.rating}
          <span class="meta font-bold text-ink-mute">({listing.reviewCount} reviews)</span>
        </p>
      )
    }

    <p class="mt-1.5 line-clamp-2 text-sm text-ink-soft">{descriptionPreview}</p>

    <p class="meta mt-auto flex flex-wrap items-baseline gap-x-3 gap-y-1 pt-3">
      {listing.county && <span class="font-bold">{listing.county} Co.</span>}
      <span class="normal-case tracking-normal">{listing.address}</span>
    </p>
  </div>
</div>
