---
// Real brand icons for a listing's contact card — only rendered for networks
// that actually have a link (see [slug].astro's `socials` filter), and only
// for the networks we have a real mark for. Anything else falls back to a
// plain monogram badge rather than a wrong/missing icon.

interface Props {
  network: string;
  href: string;
}

const { network, href } = Astro.props;
const key = network.toLowerCase();
const KNOWN = ["facebook", "instagram", "linkedin", "twitter", "x", "tiktok", "youtube"];
const fallbackLabel = key.slice(0, 2).toUpperCase();
---

<a href={href} target="_blank" rel="nofollow noopener" aria-label={network} title={network} class="block size-9 shrink-0">
  {key === "facebook" && (
    <svg viewBox="0 0 36 36" class="size-9">
      <rect width="36" height="36" rx="8" fill="#1877F2" />
      <path
        fill="#fff"
        d="M20.5 13h2V9.5h-2.4C17 9.5 15.5 11 15.5 13.8V16H13v3.5h2.5V27h3.5v-7.5h2.6l.5-3.5h-3.1v-1.7c0-.9.3-1.3 1.5-1.3Z"
      />
    </svg>
  )}
  {key === "instagram" && (
    <svg viewBox="0 0 36 36" class="size-9">
      <defs>
        <linearGradient id={`ig-${network}`} x1="0" y1="36" x2="36" y2="0">
          <stop offset="0" stop-color="#FEDA75" />
          <stop offset="0.35" stop-color="#DD2A7B" />
          <stop offset="0.7" stop-color="#962FBF" />
          <stop offset="1" stop-color="#4F5BD5" />
        </linearGradient>
      </defs>
      <rect width="36" height="36" rx="8" fill={`url(#ig-${network})`} />
      <rect x="10" y="10" width="16" height="16" rx="5" fill="none" stroke="#fff" stroke-width="2" />
      <circle cx="18" cy="18" r="4.2" fill="none" stroke="#fff" stroke-width="2" />
      <circle cx="23.2" cy="12.8" r="1.2" fill="#fff" />
    </svg>
  )}
  {(key === "twitter" || key === "x") && (
    <svg viewBox="0 0 36 36" class="size-9">
      <rect width="36" height="36" rx="8" fill="#000" />
      <path
        fill="#fff"
        d="M9.5 9.5 16 19.2 9.9 26.5h2.4l5.2-6.2 4.1 6.2h4.5l-6.8-10.2 5.7-6.8h-2.4l-4.8 5.7-3.8-5.7Z"
      />
    </svg>
  )}
  {key === "linkedin" && (
    <svg viewBox="0 0 36 36" class="size-9">
      <rect width="36" height="36" rx="8" fill="#0A66C2" />
      <rect x="9.5" y="15" width="3.4" height="11.5" fill="#fff" />
      <circle cx="11.2" cy="10.3" r="2" fill="#fff" />
      <path
        fill="#fff"
        d="M16.5 15h3.3v1.6h.05c.46-.87 1.6-1.8 3.3-1.8 3.5 0 4.2 2.3 4.2 5.3v6.4h-3.4v-5.7c0-1.35-.02-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3v5.8h-3.35Z"
      />
    </svg>
  )}
  {key === "tiktok" && (
    <svg viewBox="0 0 36 36" class="size-9">
      <rect width="36" height="36" rx="8" fill="#000" />
      <path
        d="M21.5 9c.4 2.2 1.8 3.7 4.2 3.9v3c-1.5.1-2.9-.4-4.1-1.3v6.6c0 3.4-2.7 5.8-5.9 5.8-3.2 0-5.9-2.5-5.9-5.8s2.7-5.8 5.9-5.8c.4 0 .8 0 1.2.1v3.2a3 3 0 0 0-1.2-.25 2.75 2.75 0 1 0 0 5.5c1.6 0 2.9-1.15 2.9-2.9V9Z"
        fill="#25F4EE"
        transform="translate(-0.6,-0.6)"
        opacity="0.85"
      />
      <path
        d="M21.5 9c.4 2.2 1.8 3.7 4.2 3.9v3c-1.5.1-2.9-.4-4.1-1.3v6.6c0 3.4-2.7 5.8-5.9 5.8-3.2 0-5.9-2.5-5.9-5.8s2.7-5.8 5.9-5.8c.4 0 .8 0 1.2.1v3.2a3 3 0 0 0-1.2-.25 2.75 2.75 0 1 0 0 5.5c1.6 0 2.9-1.15 2.9-2.9V9Z"
        fill="#FE2C55"
        transform="translate(0.6,0.6)"
        opacity="0.85"
      />
      <path
        d="M21.5 9c.4 2.2 1.8 3.7 4.2 3.9v3c-1.5.1-2.9-.4-4.1-1.3v6.6c0 3.4-2.7 5.8-5.9 5.8-3.2 0-5.9-2.5-5.9-5.8s2.7-5.8 5.9-5.8c.4 0 .8 0 1.2.1v3.2a3 3 0 0 0-1.2-.25 2.75 2.75 0 1 0 0 5.5c1.6 0 2.9-1.15 2.9-2.9V9Z"
        fill="#fff"
      />
    </svg>
  )}
  {key === "youtube" && (
    <svg viewBox="0 0 36 36" class="size-9">
      <rect width="36" height="36" rx="8" fill="#FF0000" />
      <path d="M15.5 13.5v9l7.5-4.5Z" fill="#fff" />
    </svg>
  )}
  {!KNOWN.includes(key) && (
    <span class="hue-block flex size-9 items-center justify-center border-2 border-rule text-[0.65rem] font-extrabold uppercase">
      {fallbackLabel}
    </span>
  )}
</a>
