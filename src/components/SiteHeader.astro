---
// Site header — one line, logo left, grouped category dropdowns, CTA hard right.
//
// Groups come from site.categoryGroups but are intersected with the categories
// that actually have listings, so an empty group never renders. Anything not
// named in a group lands in "More", which means a category arriving from a CSV
// import can never silently disappear from the nav.
//
// Dropdowns are <details>: keyboard accessible and touch-friendly with no JS.
// A few lines of script open them on hover for mouse users, matching the feel
// of the reference site without giving up the accessible baseline.

import { site } from "../config/site";
import { categorySlug } from "../lib/slug";
import { categoryHues } from "../lib/categories";
import { getListingsByCategory } from "../lib/directory";
import { countySlug, getListingsByCounty } from "../lib/counties";
import SearchBox from "./SearchBox.astro";

interface Props {
  /** Home page has the big hero search, so it hides the compact one. */
  showSearch?: boolean;
}

const { showSearch = true } = Astro.props;

// BaseLayout mounts this on EVERY page — a GHL hiccup here must degrade to
// an empty nav (still a usable page: logo, search, static links all still
// work), never crash the shared header and take the whole site down with it.
// This was a real gap: every route-level try/catch fixed elsewhere in the
// app was moot if the header itself could still blow up the page underneath it.
let byCategory: Awaited<ReturnType<typeof getListingsByCategory>> = {};
let hues: Awaited<ReturnType<typeof categoryHues>> = new Map();
let byCounty: Awaited<ReturnType<typeof getListingsByCounty>> = {};
try {
  [byCategory, hues, byCounty] = await Promise.all([
    getListingsByCategory(),
    categoryHues(),
    getListingsByCounty(),
  ]);
} catch {
  // Swallow — the nav just renders with no categories/counties below.
}

const present = Object.keys(byCategory);

const grouped = site.categoryGroups
  .map((g) => ({
    name: g.name,
    categories: g.categories.filter((c) => present.includes(c)),
  }))
  .filter((g) => g.categories.length > 0);

const claimed = new Set(grouped.flatMap((g) => g.categories));
const ungrouped = present.filter((c) => !claimed.has(c));
const groups = ungrouped.length ? [...grouped, { name: "More", categories: ungrouped }] : grouped;

const count = (c: string) => byCategory[c]?.length ?? 0;

// Explore is editorial, not categories. Only enabled links render, so the
// dropdown stays hidden until the Layer 7 pages behind it exist.
const explore = site.exploreLinks.filter((l) => l.enabled);

// Counties — the second browse axis. Only counties with listings appear, in the
// configured order, so an empty county never renders a dead page.
const counties = site.counties.filter((c) => byCounty[c.name]?.length);
---

<header class="sticky top-0 z-50 border-b-2 border-rule bg-paper/95 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:gap-6 sm:px-5">
    <a href="/" class="shrink-0">
      {
        site.logo ? (
          <img src={site.logo} alt={site.logoAlt} width="720" height="222" class="h-9 w-auto sm:h-10" />
        ) : (
          <span class="font-display text-xl font-extrabold tracking-tight">{site.name}</span>
        )
      }
    </a>


    <nav aria-label="Categories" class="hidden items-center gap-1 md:flex" data-navgroups>
      <a href="/" class="meta px-2 py-2 font-bold hover:text-signal">Home</a>
      {
        groups.map((group) => (
          <details class="group relative" data-navgroup>
            <summary class="meta flex cursor-pointer list-none items-center gap-1 px-2 py-2 font-bold marker:content-[''] hover:text-signal">
              {group.name}
              <span aria-hidden="true" class="text-[0.6em] transition-transform group-open:rotate-180">
                &#9660;
              </span>
            </summary>
            <div class="absolute left-0 top-full z-50 min-w-56 border-2 border-ink bg-paper py-1 shadow-xl">
              {group.categories.map((category) => (
                <a
                  href={`/category/${categorySlug(category)}`}
                  class={`hue-${hues.get(category)} flex items-baseline justify-between gap-4 px-4 py-2 hover:bg-paper-sunk`}
                >
                  <span class="text-sm font-semibold">{category}</span>
                  <span class="meta hue-fg font-bold">{count(category)}</span>
                </a>
              ))}
            </div>
          </details>
        ))
      }
      {
        counties.length > 0 && (
          <details class="group relative" data-navgroup>
            <summary class="meta flex cursor-pointer list-none items-center gap-1 px-2 py-2 font-bold marker:content-[''] hover:text-signal">
              Counties
              <span aria-hidden="true" class="text-[0.6em] transition-transform group-open:rotate-180">
                &#9660;
              </span>
            </summary>
            <div class="absolute left-0 top-full z-50 min-w-64 border-2 border-ink bg-paper py-1 shadow-xl">
              {counties.map((c) => (
                <a
                  href={`/county/${countySlug(c.name)}`}
                  class="flex items-baseline justify-between gap-4 px-4 py-2 hover:bg-paper-sunk"
                >
                  <span class="text-sm font-semibold">{c.name} County</span>
                  <span class="meta">{byCounty[c.name]!.length}</span>
                </a>
              ))}
            </div>
          </details>
        )
      }

      <a href="/pricing" class="meta px-2 py-2 font-bold hover:text-signal">Get listed</a>

      {
        explore.length > 0 && (
          <details class="group relative" data-navgroup>
            <summary class="meta flex cursor-pointer list-none items-center gap-1 px-2 py-2 font-bold marker:content-[''] hover:text-signal">
              Explore
              <span aria-hidden="true" class="text-[0.6em] transition-transform group-open:rotate-180">
                &#9660;
              </span>
            </summary>
            <div class="absolute left-0 top-full z-50 min-w-52 border-2 border-ink bg-paper py-1 shadow-xl">
              {explore.map((l) => (
                <a href={l.href} class="block px-4 py-2 text-sm font-semibold hover:bg-paper-sunk">
                  {l.label}
                </a>
              ))}
            </div>
          </details>
        )
      }

      <a href="/listings" class="meta px-2 py-2 font-bold hover:text-signal">All listings</a>
      <a href="/about" class="meta px-2 py-2 font-bold hover:text-signal">About</a>
    </nav>

    <details class="relative md:hidden" data-navgroup>
      <summary class="meta flex cursor-pointer list-none items-center gap-1 py-2 font-bold marker:content-['']">
        Categories <span aria-hidden="true" class="text-[0.6em]">&#9660;</span>
      </summary>
      <div class="absolute left-0 top-full z-50 max-h-[70vh] min-w-64 overflow-y-auto border-2 border-ink bg-paper py-1 shadow-xl">
        <a href="/" class="meta block px-4 py-2 font-bold">Home</a>
        {
          groups.map((group) => (
            <div class="border-b border-rule py-1 last:border-0">
              <p class="meta px-4 py-1">{group.name}</p>
              {group.categories.map((category) => (
                <a
                  href={`/category/${categorySlug(category)}`}
                  class={`hue-${hues.get(category)} flex items-baseline justify-between gap-4 px-4 py-2`}
                >
                  <span class="text-sm font-semibold">{category}</span>
                  <span class="meta hue-fg font-bold">{count(category)}</span>
                </a>
              ))}
            </div>
          ))
        }
        {counties.length > 0 && (
          <div class="border-b border-rule py-1">
            <p class="meta px-4 py-1">Counties</p>
            {counties.map((c) => (
              <a
                href={`/county/${countySlug(c.name)}`}
                class="flex items-baseline justify-between gap-4 px-4 py-2"
              >
                <span class="text-sm font-semibold">{c.name} County</span>
                <span class="meta">{byCounty[c.name]!.length}</span>
              </a>
            ))}
          </div>
        )}
        <a href="/pricing" class="meta block px-4 py-2 font-bold">Get listed</a>
        {explore.map((l) => (
          <a href={l.href} class="block px-4 py-2 text-sm font-semibold">
            {l.label}
          </a>
        ))}
        <a href="/listings" class="meta block px-4 py-2 font-bold">All listings</a>
        <a href="/about" class="meta block px-4 py-2 font-bold">About</a>
        <div data-guest-only class="flex-col border-t border-rule">
          <a href="/account/login" class="meta block px-4 py-2 font-bold">Login</a>
          <a href="/account/register" class="meta block px-4 py-2 font-bold">Register</a>
        </div>
        <div data-account-only class="flex-col border-t border-rule">
          <a href="/account" class="meta block px-4 py-2 font-bold">Profile</a>
          <form method="POST" action="/api/manage/logout">
            <button type="submit" class="meta block w-full px-4 py-2 text-left font-bold">Logout</button>
          </form>
        </div>
        <div data-admin-only class="flex-col border-t border-rule">
          <a href="/manage/admin" class="meta block px-4 py-2 font-bold">Admin</a>
          <form method="POST" action="/api/manage/logout">
            <button type="submit" class="meta block w-full px-4 py-2 text-left font-bold">Sign out</button>
          </form>
        </div>
      </div>
    </details>

    <div class="ml-auto flex shrink-0 items-center gap-3">
      {
        showSearch && (
          <div class="hidden w-56 border-2 border-ink xl:block">
            <SearchBox variant="compact" id="header-search" placeholder="Search" />
          </div>
        )
      }
      <a
        href="/pricing"
        class="shrink-0 whitespace-nowrap border-2 border-ink bg-ink px-3 py-2 text-xs font-bold text-paper hover:border-signal hover:bg-signal sm:px-4 sm:text-sm"
      >
        Add your business
      </a>

      {/* All three blocks always render — [data-consumer]/[data-admin] (set
          pre-paint in BaseLayout.astro) pick which one shows, defaulting to
          guest so a no-JS visitor never sees a false logged-in shell. Admin
          and consumer are separate identity systems, so at most one of
          data-account-only/data-admin-only is ever shown alongside
          data-guest-only being hidden — never both at once in practice,
          since logging into one overwrites the other's session cookie. */}
      <div data-guest-only class="shrink-0 items-center gap-1">
        <a href="/account/login" class="meta px-2 py-2 font-bold hover:text-signal">Login</a>
        <a href="/account/register" class="meta px-2 py-2 font-bold hover:text-signal">Register</a>
      </div>
      <div data-account-only class="shrink-0 items-center gap-1">
        <a href="/account" class="meta px-2 py-2 font-bold hover:text-signal">Profile</a>
        <form method="POST" action="/api/manage/logout">
          <button type="submit" class="meta px-2 py-2 font-bold hover:text-signal">Logout</button>
        </form>
      </div>
      <div data-admin-only class="shrink-0 items-center gap-1">
        <a href="/manage/admin" class="meta px-2 py-2 font-bold hover:text-signal">Admin</a>
        <form method="POST" action="/api/manage/logout">
          <button type="submit" class="meta px-2 py-2 font-bold hover:text-signal">Sign out</button>
        </form>
      </div>

      <button
        type="button"
        data-theme-toggle
        aria-label="Switch between light and dark theme"
        class="flex size-9 shrink-0 items-center justify-center border-2 border-ink text-ink hover:border-signal hover:text-signal"
      >
        <svg data-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-4" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg data-icon="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  // Open dropdowns on hover for mouse users; click/keyboard still works.
  // Skipped on touch, where hover would fire on the first tap and fight the tap.
  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    document.querySelectorAll<HTMLDetailsElement>("[data-navgroup]").forEach((d) => {
      let timer: number;
      d.addEventListener("mouseenter", () => {
        clearTimeout(timer);
        document
          .querySelectorAll<HTMLDetailsElement>("[data-navgroup][open]")
          .forEach((o) => o !== d && (o.open = false));
        d.open = true;
      });
      d.addEventListener("mouseleave", () => {
        timer = window.setTimeout(() => (d.open = false), 120);
      });
    });
  }

  // Click outside or Escape closes any open dropdown.
  document.addEventListener("click", (e) => {
    document.querySelectorAll<HTMLDetailsElement>("[data-navgroup][open]").forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      document
        .querySelectorAll<HTMLDetailsElement>("[data-navgroup][open]")
        .forEach((d) => (d.open = false));
    }
  });

  // Theme toggle. The initial theme itself is set by a blocking inline
  // script in BaseLayout's <head> (before paint); this just handles clicks
  // and keeps aria-pressed in sync, both here and on any other header
  // instance on the page (there's only ever one, but querySelectorAll is
  // cheap insurance against that assumption changing).
  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((toggle) => {
    const sync = () =>
      toggle.setAttribute("aria-pressed", String(document.documentElement.dataset.theme === "dark"));
    sync();
    toggle.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
      document.documentElement.dataset.theme = next;
      localStorage.setItem("theme", next);
      sync();
    });
  });
</script>
