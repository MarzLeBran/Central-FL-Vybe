---
// Shared owner self-serve / admin listing-edit UI. Used by both
// src/pages/manage/index.astro (owner, session-bound to one listing) and
// src/pages/manage/admin/[slug].astro (admin, listingId comes from the URL) —
// one edit UI to maintain, not two. Follows SearchBox.astro's plain
// <script> + data-*-attribute DOM-hook convention; no UI framework.
//
// Blog/news/events/team share one generic list-editor pattern client-side
// (makeEntriesController, in the script below) — they differ only in which
// text fields they carry, not in the add/edit/remove/image-upload mechanics.

interface Props {
  listingId: string;
  description: string;
  imageUrls: string[];
  logoUrl?: string;
  address: string;
  phone: string;
  email?: string;
  website?: string;
  youtubeUrl?: string;
  bookingUrl?: string;
  socialLinks?: Record<string, string>;
  extraLinks?: { label: string; url: string }[];
  specialOffer?: string;
  specialOfferImageUrl?: string;
  blogPosts?: { id: string; title: string; date: string; body: string; imageUrl?: string }[];
  newsItems?: { id: string; title: string; date: string; body: string; imageUrl?: string }[];
  events?: { id: string; title: string; date: string; time?: string; location?: string; description: string; imageUrl?: string }[];
  team?: { id: string; name: string; role: string; bio?: string; imageUrl?: string }[];
}

const {
  listingId,
  description,
  imageUrls,
  logoUrl,
  address,
  phone,
  email,
  website,
  youtubeUrl,
  bookingUrl,
  socialLinks = {},
  extraLinks = [],
  specialOffer,
  specialOfferImageUrl,
  blogPosts = [],
  newsItems = [],
  events = [],
  team = [],
} = Astro.props;

const SOCIAL_NETWORKS: [string, string][] = [
  ["facebook", "Facebook"],
  ["instagram", "Instagram"],
  ["x", "X (Twitter)"],
  ["linkedin", "LinkedIn"],
  ["tiktok", "TikTok"],
  ["youtube", "YouTube"],
];
---

<div data-edit-form data-listing-id={listingId} class="space-y-8">
  <div data-status class="hidden border-2 px-4 py-3 text-sm font-semibold"></div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for="address" class="meta mb-1.5 block">Address</label>
      <input
        id="address"
        data-field="address"
        type="text"
        value={address}
        required
        class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
      />
    </div>
    <div>
      <label for="phone" class="meta mb-1.5 block">Phone</label>
      <input
        id="phone"
        data-field="phone"
        type="tel"
        value={phone}
        required
        class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
      />
    </div>
    <div>
      <label for="email" class="meta mb-1.5 block">Email</label>
      <input
        id="email"
        data-field="email"
        type="email"
        value={email ?? ""}
        required
        class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
      />
      <p class="mt-1 text-xs text-ink-mute">This is also your sign-in email — changing it changes what you log in with.</p>
    </div>
    <div>
      <label for="website" class="meta mb-1.5 block">Website (optional)</label>
      <input
        id="website"
        data-field="website"
        type="url"
        value={website ?? ""}
        placeholder="https://…"
        class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
      />
    </div>
  </div>

  <div>
    <div class="mb-1.5 flex items-baseline justify-between">
      <label for="description" class="meta">Description</label>
      <button type="button" data-preview class="meta font-bold hover:text-signal">Preview</button>
    </div>
    <textarea
      id="description"
      data-field="description"
      rows="6"
      maxlength="10000"
      class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
    >{description}</textarea>
    <div data-preview-pane class="aeo-content hidden border-2 border-rule bg-paper-sunk px-4 py-3 text-sm"></div>
    <p class="mt-1 text-xs text-ink-mute">
      Formatting: <code>**bold**</code>, <code>## Heading</code>, <code>- bullet point</code>. Links
      aren't supported and won't be clickable — write the name or URL as plain text instead.
    </p>
  </div>

  <div>
    <p class="meta mb-1.5">Logo</p>
    <div class="flex items-center gap-4">
      <img
        data-logo-preview
        src={logoUrl || undefined}
        class:list={["h-16 w-16 border-2 border-rule bg-paper object-contain", !logoUrl && "hidden"]}
        alt=""
      />
      <input type="file" accept="image/*" data-logo-input class="text-sm" />
    </div>
    <input type="hidden" data-field="logoUrl" value={logoUrl ?? ""} />
  </div>

  <div>
    <p class="meta mb-1.5">Photos</p>
    <ul data-gallery data-initial={JSON.stringify(imageUrls)} class="grid grid-cols-2 gap-3 sm:grid-cols-3"></ul>
    <input type="file" accept="image/*" multiple data-gallery-input class="mt-3 text-sm" />
    <p class="mt-1 text-xs text-ink-mute">
      Drag to reorder, or use the arrows. The first photo is the cover image shown on the listing card.
    </p>
  </div>

  <div>
    <label for="youtubeUrl" class="meta mb-1.5 block">YouTube video (optional)</label>
    <input
      id="youtubeUrl"
      data-field="youtubeUrl"
      type="url"
      value={youtubeUrl ?? ""}
      placeholder="https://www.youtube.com/watch?v=..."
      class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
    />
  </div>

  <div>
    <label for="bookingUrl" class="meta mb-1.5 block">Booking link (optional)</label>
    <input
      id="bookingUrl"
      data-field="bookingUrl"
      type="url"
      value={bookingUrl ?? ""}
      placeholder="https://calendly.com/..."
      class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
    />
  </div>

  <div>
    <p class="meta mb-1.5">Social media (optional)</p>
    <div class="grid gap-3 sm:grid-cols-2" data-social-fields>
      {SOCIAL_NETWORKS.map(([key, label]) => (
        <input
          data-social-field={key}
          type="url"
          value={socialLinks[key] ?? ""}
          placeholder={label}
          aria-label={label}
          class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
        />
      ))}
    </div>
  </div>

  <div>
    <label for="specialOffer" class="meta mb-1.5 block">Special offer (optional)</label>
    <input
      id="specialOffer"
      data-field="specialOffer"
      type="text"
      value={specialOffer ?? ""}
      maxlength="300"
      placeholder="e.g. 15% off first visit for new customers"
      class="w-full border-2 border-rule bg-paper px-4 py-2.5 text-sm focus:border-ink focus:outline-none"
    />
    <div class="mt-2 flex items-center gap-4">
      <img
        data-offer-image-preview
        src={specialOfferImageUrl || undefined}
        class:list={["h-16 w-16 border-2 border-rule bg-paper object-cover", !specialOfferImageUrl && "hidden"]}
        alt=""
      />
      <input type="file" accept="image/*" data-offer-image-input class="text-sm" />
    </div>
    <input type="hidden" data-field="specialOfferImageUrl" value={specialOfferImageUrl ?? ""} />
    <p class="mt-1 text-xs text-ink-mute">
      Shows as a deal card on the homepage and your listing page. The photo is optional but makes it stand out more.
    </p>
  </div>

  <div>
    <p class="meta mb-1.5">Extra links (optional)</p>
    <ul data-extra-links data-initial={JSON.stringify(extraLinks)} class="space-y-2"></ul>
    <button type="button" data-add-link class="meta mt-2 font-bold hover:text-signal">+ Add a link</button>
    <p class="mt-1 text-xs text-ink-mute">Up to 6 — a menu, a booking page, another location, anything with a URL.</p>
  </div>

  <div class="space-y-8 border-t-2 border-rule pt-8">
    <div>
      <p class="meta mb-1.5">Team (optional)</p>
      <ul data-entries="team" data-initial={JSON.stringify(team)} class="space-y-3"></ul>
      <button type="button" data-add-entry="team" class="meta mt-2 font-bold hover:text-signal">+ Add a team member</button>
    </div>

    <div>
      <p class="meta mb-1.5">Events (optional)</p>
      <ul data-entries="events" data-initial={JSON.stringify(events)} class="space-y-3"></ul>
      <button type="button" data-add-entry="events" class="meta mt-2 font-bold hover:text-signal">+ Add an event</button>
    </div>

    <div>
      <p class="meta mb-1.5">News (optional)</p>
      <ul data-entries="newsItems" data-initial={JSON.stringify(newsItems)} class="space-y-3"></ul>
      <button type="button" data-add-entry="newsItems" class="meta mt-2 font-bold hover:text-signal">+ Add a news story</button>
    </div>

    <div>
      <p class="meta mb-1.5">Blog (optional)</p>
      <ul data-entries="blogPosts" data-initial={JSON.stringify(blogPosts)} class="space-y-3"></ul>
      <button type="button" data-add-entry="blogPosts" class="meta mt-2 font-bold hover:text-signal">+ Add a blog post</button>
    </div>
  </div>

  <button type="button" data-save class="bg-signal px-5 py-3.5 text-sm font-bold text-paper hover:bg-signal-sunk">
    Save changes
  </button>
</div>

<script>
  type GalleryItem = { url: string };

  const sanitizeFilename = (name: string) => name.replace(/[^a-zA-Z0-9.\-]/g, "_");
  // Values go into innerHTML as attribute content — escape the quote that
  // would otherwise break out of the attribute (renderExtraLinks below).
  const escapeAttr = (s: string) => s.replace(/&/g, "&amp;").replace(/"/g, "&quot;");
  // Same idea for values going into innerHTML as element TEXT content
  // (textarea bodies below) — escaping < and > keeps a stray "</textarea>"
  // or "<script>" in someone's post body from breaking out of the tag.
  const escapeHtml = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

  type EntryField = { key: string; label: string; type: "text" | "date" | "textarea" };
  const ENTRY_TYPES: Record<string, EntryField[]> = {
    team: [
      { key: "name", label: "Name", type: "text" },
      { key: "role", label: "Role", type: "text" },
      { key: "bio", label: "Short bio (optional)", type: "textarea" },
    ],
    events: [
      { key: "title", label: "Event title", type: "text" },
      { key: "date", label: "Date", type: "date" },
      { key: "time", label: "Time (optional)", type: "text" },
      { key: "location", label: "Location (optional)", type: "text" },
      { key: "description", label: "Description", type: "textarea" },
    ],
    newsItems: [
      { key: "title", label: "Headline", type: "text" },
      { key: "date", label: "Date", type: "date" },
      { key: "body", label: "Story", type: "textarea" },
    ],
    blogPosts: [
      { key: "title", label: "Post title", type: "text" },
      { key: "date", label: "Date", type: "date" },
      { key: "body", label: "Post", type: "textarea" },
    ],
  };

  document.querySelectorAll<HTMLElement>("[data-edit-form]").forEach((root) => {
    const listingId = root.dataset.listingId!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const description = root.querySelector<HTMLTextAreaElement>('[data-field="description"]')!;
    const previewBtn = root.querySelector<HTMLButtonElement>("[data-preview]")!;
    const previewPane = root.querySelector<HTMLElement>("[data-preview-pane]")!;
    const youtubeUrl = root.querySelector<HTMLInputElement>('[data-field="youtubeUrl"]')!;
    const bookingUrl = root.querySelector<HTMLInputElement>('[data-field="bookingUrl"]')!;
    const socialFields = root.querySelectorAll<HTMLInputElement>("[data-social-field]");
    const logoField = root.querySelector<HTMLInputElement>('[data-field="logoUrl"]')!;
    const logoInput = root.querySelector<HTMLInputElement>("[data-logo-input]")!;
    const logoPreview = root.querySelector<HTMLImageElement>("[data-logo-preview]")!;
    const galleryList = root.querySelector<HTMLUListElement>("[data-gallery]")!;
    const galleryInput = root.querySelector<HTMLInputElement>("[data-gallery-input]")!;
    const addressField = root.querySelector<HTMLInputElement>('[data-field="address"]')!;
    const phoneField = root.querySelector<HTMLInputElement>('[data-field="phone"]')!;
    const emailField = root.querySelector<HTMLInputElement>('[data-field="email"]')!;
    const websiteField = root.querySelector<HTMLInputElement>('[data-field="website"]')!;
    const specialOfferField = root.querySelector<HTMLInputElement>('[data-field="specialOffer"]')!;
    const extraLinksList = root.querySelector<HTMLUListElement>("[data-extra-links]")!;
    const addLinkBtn = root.querySelector<HTMLButtonElement>("[data-add-link]")!;
    const saveBtn = root.querySelector<HTMLButtonElement>("[data-save]")!;

    let gallery: GalleryItem[] = JSON.parse(galleryList.dataset.initial || "[]");
    let dragFrom: number | null = null;
    let extraLinks: { label: string; url: string }[] = JSON.parse(extraLinksList.dataset.initial || "[]");

    const showStatus = (message: string, kind: "ok" | "error") => {
      status.textContent = message;
      status.classList.remove("hidden", "border-signal", "text-signal-sunk", "border-ink", "text-ink");
      status.classList.add(...(kind === "ok" ? ["border-ink", "text-ink"] : ["border-signal", "text-signal-sunk"]));
    };

    const renderGallery = () => {
      galleryList.innerHTML = gallery
        .map(
          (item, i) => `
        <li draggable="true" data-i="${i}" class="group relative border-2 ${i === 0 ? "border-signal" : "border-rule"}">
          <img src="${item.url}" class="aspect-square w-full object-cover" alt="" />
          ${i === 0 ? '<span class="absolute left-1 top-1 bg-signal px-1.5 py-0.5 text-[10px] font-bold text-paper">COVER</span>' : ""}
          <div class="absolute inset-x-0 bottom-0 flex items-center justify-between bg-ink/70 px-1 py-1">
            <div class="flex gap-1">
              <button type="button" data-move="-1" aria-label="Move earlier" class="px-1 text-xs text-paper">&larr;</button>
              <button type="button" data-move="1" aria-label="Move later" class="px-1 text-xs text-paper">&rarr;</button>
            </div>
            <div class="flex gap-1">
              ${i !== 0 ? '<button type="button" data-cover aria-label="Set as cover" class="px-1 text-[10px] font-bold text-paper">COVER</button>' : ""}
              <button type="button" data-remove aria-label="Remove photo" class="px-1 text-xs text-paper">&times;</button>
            </div>
          </div>
        </li>`
        )
        .join("");
    };

    galleryList.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-i]");
      if (!li) return;
      const i = Number(li.dataset.i);
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button");
      if (!btn) return;

      if (btn.dataset.move) {
        const dir = Number(btn.dataset.move);
        const j = i + dir;
        if (j < 0 || j >= gallery.length) return;
        [gallery[i], gallery[j]] = [gallery[j], gallery[i]];
      } else if (btn.dataset.cover !== undefined) {
        const [item] = gallery.splice(i, 1);
        gallery.unshift(item);
      } else if (btn.dataset.remove !== undefined) {
        gallery.splice(i, 1);
      } else {
        return;
      }
      renderGallery();
    });

    // Native HTML5 drag-and-drop reorder — the arrow buttons above are the
    // keyboard-accessible fallback, since DnD alone isn't keyboard-navigable.
    galleryList.addEventListener("dragstart", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-i]");
      dragFrom = li ? Number(li.dataset.i) : null;
    });
    galleryList.addEventListener("dragover", (e) => e.preventDefault());
    galleryList.addEventListener("drop", (e) => {
      e.preventDefault();
      const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-i]");
      if (!li || dragFrom === null) return;
      const to = Number(li.dataset.i);
      const [item] = gallery.splice(dragFrom, 1);
      gallery.splice(to, 0, item);
      dragFrom = null;
      renderGallery();
    });

    const renderExtraLinks = () => {
      extraLinksList.innerHTML = extraLinks
        .map(
          (link, i) => `
        <li data-i="${i}" class="flex gap-2">
          <input data-link-label value="${escapeAttr(link.label)}" placeholder="Label" class="w-1/3 border-2 border-rule bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none" />
          <input data-link-url value="${escapeAttr(link.url)}" placeholder="https://…" class="flex-1 border-2 border-rule bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none" />
          <button type="button" data-remove-link aria-label="Remove link" class="px-2 text-ink-mute hover:text-signal">&times;</button>
        </li>`
        )
        .join("");
    };

    extraLinksList.addEventListener("input", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-i]");
      if (!li) return;
      const i = Number(li.dataset.i);
      const label = li.querySelector<HTMLInputElement>("[data-link-label]")!.value;
      const url = li.querySelector<HTMLInputElement>("[data-link-url]")!.value;
      extraLinks[i] = { label, url };
    });

    extraLinksList.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-link]");
      if (!btn) return;
      const li = btn.closest<HTMLLIElement>("li[data-i]")!;
      extraLinks.splice(Number(li.dataset.i), 1);
      renderExtraLinks();
    });

    addLinkBtn.addEventListener("click", () => {
      if (extraLinks.length >= 6) return;
      extraLinks.push({ label: "", url: "" });
      renderExtraLinks();
    });

    async function uploadOne(file: File): Promise<string> {
      const { upload } = await import("@vercel/blob/client");
      const pathname = `listings/${listingId}/${crypto.randomUUID()}-${sanitizeFilename(file.name)}`;
      const blob = await upload(pathname, file, {
        access: "public",
        handleUploadUrl: "/api/manage/upload",
        clientPayload: JSON.stringify({ listingId }),
      });
      return blob.url;
    }

    galleryInput.addEventListener("change", async () => {
      const files = Array.from(galleryInput.files ?? []);
      if (!files.length) return;
      showStatus("Uploading photos…", "ok");
      try {
        const urls = await Promise.all(files.map(uploadOne));
        gallery.push(...urls.map((url) => ({ url })));
        renderGallery();
        status.classList.add("hidden");
      } catch (err) {
        showStatus(`Upload failed: ${(err as Error).message}`, "error");
      } finally {
        galleryInput.value = "";
      }
    });

    logoInput.addEventListener("change", async () => {
      const file = logoInput.files?.[0];
      if (!file) return;
      showStatus("Uploading logo…", "ok");
      try {
        const url = await uploadOne(file);
        logoField.value = url;
        logoPreview.src = url;
        logoPreview.classList.remove("hidden");
        status.classList.add("hidden");
      } catch (err) {
        showStatus(`Upload failed: ${(err as Error).message}`, "error");
      } finally {
        logoInput.value = "";
      }
    });

    const offerImageField = root.querySelector<HTMLInputElement>('[data-field="specialOfferImageUrl"]')!;
    const offerImageInput = root.querySelector<HTMLInputElement>("[data-offer-image-input]")!;
    const offerImagePreview = root.querySelector<HTMLImageElement>("[data-offer-image-preview]")!;
    offerImageInput.addEventListener("change", async () => {
      const file = offerImageInput.files?.[0];
      if (!file) return;
      showStatus("Uploading photo…", "ok");
      try {
        const url = await uploadOne(file);
        offerImageField.value = url;
        offerImagePreview.src = url;
        offerImagePreview.classList.remove("hidden");
        status.classList.add("hidden");
      } catch (err) {
        showStatus(`Upload failed: ${(err as Error).message}`, "error");
      } finally {
        offerImageInput.value = "";
      }
    });

    // Shared list-editor for team/events/news/blog — same add/edit/remove/
    // image-upload mechanics for all four, they only differ in which text
    // fields they carry (ENTRY_TYPES above). One controller instance per
    // content type; getValues() is called at save time.
    function makeEntriesController(key: string, fields: EntryField[]) {
      const container = root.querySelector<HTMLElement>(`[data-entries="${key}"]`)!;
      const addBtn = root.querySelector<HTMLButtonElement>(`[data-add-entry="${key}"]`)!;
      let items: Record<string, string>[] = JSON.parse(container.dataset.initial || "[]");

      const render = () => {
        container.innerHTML = items
          .map((item, i) => {
            const fieldsHtml = fields
              .map((f) =>
                f.type === "textarea"
                  ? `<textarea data-entry-field="${f.key}" rows="3" placeholder="${f.label}" class="w-full border-2 border-rule bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none">${escapeHtml(item[f.key] ?? "")}</textarea>`
                  : `<input data-entry-field="${f.key}" type="${f.type}" value="${escapeAttr(item[f.key] ?? "")}" placeholder="${f.label}" class="w-full border-2 border-rule bg-paper px-3 py-2 text-sm focus:border-ink focus:outline-none" />`
              )
              .join("");
            return `
        <li data-i="${i}" class="space-y-2 border-2 border-rule p-3">
          ${fieldsHtml}
          <div class="flex items-center gap-3">
            <img data-entry-image-preview src="${item.imageUrl ?? ""}" class="h-12 w-12 border-2 border-rule bg-paper object-cover ${item.imageUrl ? "" : "hidden"}" alt="" />
            <input type="file" accept="image/*" data-entry-image-input class="text-xs" />
            <button type="button" data-remove-entry aria-label="Remove" class="meta ml-auto font-bold text-ink-mute hover:text-signal">Remove</button>
          </div>
        </li>`;
          })
          .join("");
      };

      container.addEventListener("input", (e) => {
        const li = (e.target as HTMLElement).closest<HTMLLIElement>("li[data-i]");
        const fieldEl = (e.target as HTMLElement).closest<HTMLInputElement | HTMLTextAreaElement>("[data-entry-field]");
        if (!li || !fieldEl) return;
        items[Number(li.dataset.i)][fieldEl.dataset.entryField!] = fieldEl.value;
      });

      container.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-entry]");
        if (!btn) return;
        items.splice(Number(btn.closest<HTMLLIElement>("li[data-i]")!.dataset.i), 1);
        render();
      });

      container.addEventListener("change", async (e) => {
        const input = (e.target as HTMLElement).closest<HTMLInputElement>("[data-entry-image-input]");
        if (!input) return;
        const li = input.closest<HTMLLIElement>("li[data-i]")!;
        const i = Number(li.dataset.i);
        const file = input.files?.[0];
        if (!file) return;
        showStatus("Uploading photo…", "ok");
        try {
          items[i].imageUrl = await uploadOne(file);
          status.classList.add("hidden");
          render();
        } catch (err) {
          showStatus(`Upload failed: ${(err as Error).message}`, "error");
        }
      });

      addBtn.addEventListener("click", () => {
        if (items.length >= 20) return;
        items.push({});
        render();
      });

      render();
      return { getValues: () => items };
    }

    const teamEntries = makeEntriesController("team", ENTRY_TYPES.team);
    const eventsEntries = makeEntriesController("events", ENTRY_TYPES.events);
    const newsEntries = makeEntriesController("newsItems", ENTRY_TYPES.newsItems);
    const blogEntries = makeEntriesController("blogPosts", ENTRY_TYPES.blogPosts);

    // Toggles between the textarea and a rendered preview — reuses the exact
    // publish-time renderer server-side (src/lib/markdown.ts), so what's
    // shown here is exactly what the live page will show, not an
    // approximation. Not live-as-you-type: one click, one round-trip.
    previewBtn.addEventListener("click", async () => {
      const showingPreview = !previewPane.classList.contains("hidden");
      if (showingPreview) {
        previewPane.classList.add("hidden");
        description.classList.remove("hidden");
        previewBtn.textContent = "Preview";
        return;
      }
      previewBtn.disabled = true;
      previewBtn.textContent = "Loading…";
      try {
        const res = await fetch("/api/manage/preview-description", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ description: description.value }),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) throw new Error(result.error ?? `preview failed (${res.status})`);
        previewPane.innerHTML = result.html;
        previewPane.classList.remove("hidden");
        description.classList.add("hidden");
        previewBtn.textContent = "Back to editing";
      } catch (err) {
        showStatus(`Preview failed: ${(err as Error).message}`, "error");
      } finally {
        previewBtn.disabled = false;
        if (previewPane.classList.contains("hidden")) previewBtn.textContent = "Preview";
      }
    });

    saveBtn.addEventListener("click", async () => {
      saveBtn.disabled = true;
      saveBtn.textContent = "Saving…";
      try {
        const res = await fetch("/api/manage/update", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            listingId,
            description: description.value,
            imageUrls: gallery.map((g) => g.url),
            logoUrl: logoField.value || undefined,
            address: addressField.value,
            phone: phoneField.value,
            email: emailField.value,
            website: websiteField.value || undefined,
            youtubeUrl: youtubeUrl.value || undefined,
            bookingUrl: bookingUrl.value || undefined,
            socialLinks: Object.fromEntries(
              [...socialFields]
                .map((el) => [el.dataset.socialField!, el.value.trim()])
                .filter(([, url]) => url)
            ),
            extraLinks: extraLinks.filter((l) => l.label.trim() && l.url.trim()),
            specialOffer: specialOfferField.value || undefined,
            specialOfferImageUrl: offerImageField.value || undefined,
            team: teamEntries.getValues(),
            events: eventsEntries.getValues(),
            newsItems: newsEntries.getValues(),
            blogPosts: blogEntries.getValues(),
          }),
        });
        const result = await res.json();
        if (!res.ok || !result.ok) throw new Error(result.error ?? `save failed (${res.status})`);
        showStatus("Saved. Changes go live on the next site rebuild.", "ok");
      } catch (err) {
        showStatus(`Save failed: ${(err as Error).message}`, "error");
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = "Save changes";
      }
    });

    renderGallery();
    renderExtraLinks();
  });
</script>
